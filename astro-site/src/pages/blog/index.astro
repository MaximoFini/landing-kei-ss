---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogStructuredData from "@/components/BlogStructuredData.astro";

// Port of app/blog/page.tsx.
// getAllPosts(): newest first. getFeaturedPosts()/regularPosts derive from that
// same sorted list (the Next array sort mutates in place before both reads).
const allPosts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const featuredPosts = allPosts.filter((post) => post.data.featured);
const regularPosts = allPosts.filter((post) => !post.data.featured);

// `timeZone: "UTC"` pins the output to the frontmatter calendar date regardless
// of the build host's timezone (the Next code omitted it and relied on the build
// server running in UTC — matching that production output here).
const longDate = (d: string) =>
  new Date(d).toLocaleDateString("es-AR", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
const shortDate = (d: string) =>
  new Date(d).toLocaleDateString("es-AR", {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---

<BaseLayout
  title="Blog de Desarrollo y Tecnología"
  description="Artículos sobre desarrollo de software, inteligencia artificial, automatización y mejores prácticas de programación."
  canonical="https://keisoftware.dev/blog"
  ogTitle="Blog | KEI Software"
  ogDescription="Artículos sobre desarrollo de software, IA y automatización"
  ogUrl="https://keisoftware.dev/blog"
  image="/blog/opengraph-image.png"
  ogImageAlt="Blog · KEI Software"
>
  <div class="min-h-screen bg-background">
    <BlogStructuredData mode="list" posts={allPosts} />
    {/* Header */}
    <header class="border-b border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-neon transition-colors"
        >
          ← Volver al inicio
        </a>
      </div>
    </header>

    {/* Hero */}
    <section
      class="pt-16 sm:pt-24 pb-12 sm:pb-16 px-4 sm:px-6 border-b border-border/40"
    >
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-neon"></span>
          <span
            class="text-[10px] tracking-[0.3em] text-neon uppercase font-mono"
          >
            Blog
          </span>
        </div>
        <h1
          class="text-4xl sm:text-6xl lg:text-7xl font-black text-foreground uppercase tracking-tight leading-none mb-6"
        >
          Desarrollo de Software, IA<br />
          <span class="text-neon">y Automatización</span>
        </h1>
        <p class="max-w-2xl text-muted-foreground text-lg leading-relaxed">
          Exploramos desarrollo de software, IA, automatización y las
          tecnologías que están transformando la industria.
        </p>
      </div>
    </section>

    {/* Featured Posts */}
    {
      featuredPosts.length > 0 && (
        <section class="py-12 sm:py-16 px-4 sm:px-6 bg-surface/20">
          <div class="max-w-7xl mx-auto">
            <h2 class="text-sm font-mono tracking-wider text-muted-foreground uppercase mb-8">
              Destacados
            </h2>
            <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
              {featuredPosts.map((post) => (
                <a
                  href={`/blog/${post.id}`}
                  class="group block p-6 sm:p-8 border border-border/60 rounded-sm hover:border-neon/40 hover:bg-surface/50 transition-all duration-300"
                >
                  <div class="flex items-center gap-2 mb-4">
                    <span class="text-xs font-mono text-neon uppercase tracking-wider">
                      {post.data.category}
                    </span>
                    <span class="text-muted-foreground">·</span>
                    <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-3 h-3"
                      >
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                      </svg>
                      {post.data.readTime}
                    </div>
                  </div>
                  <h3 class="text-xl sm:text-2xl font-bold text-foreground mb-3 group-hover:text-neon transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="text-muted-foreground text-sm sm:text-base leading-relaxed mb-4">
                    {post.data.excerpt}
                  </p>
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-3 h-3"
                      >
                        <path d="M8 2v4" />
                        <path d="M16 2v4" />
                        <rect width="18" height="18" x="3" y="4" rx="2" />
                        <path d="M3 10h18" />
                      </svg>
                      {longDate(post.data.date)}
                    </div>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="w-4 h-4 text-neon opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* Regular Posts */}
    <section class="py-12 sm:py-16 px-4 sm:px-6">
      <div class="max-w-7xl mx-auto">
        <h2
          class="text-sm font-mono tracking-wider text-muted-foreground uppercase mb-8"
        >
          Todos los artículos
        </h2>
        <div class="space-y-6">
          {
            regularPosts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="group block p-6 border-b border-border/40 hover:bg-surface/30 transition-all -mx-6 px-6"
              >
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                  <div class="flex-1">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-xs font-mono text-neon uppercase tracking-wider">
                        {post.data.category}
                      </span>
                      <span class="text-muted-foreground">·</span>
                      <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="w-3 h-3"
                        >
                          <circle cx="12" cy="12" r="10" />
                          <polyline points="12 6 12 12 16 14" />
                        </svg>
                        {post.data.readTime}
                      </div>
                    </div>
                    <h3 class="text-lg sm:text-xl font-bold text-foreground mb-2 group-hover:text-neon transition-colors">
                      {post.data.title}
                    </h3>
                    <p class="text-muted-foreground text-sm leading-relaxed">
                      {post.data.excerpt}
                    </p>
                  </div>
                  <div class="flex items-center gap-3 sm:flex-col sm:items-end sm:gap-2">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground whitespace-nowrap">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-3 h-3"
                      >
                        <path d="M8 2v4" />
                        <path d="M16 2v4" />
                        <rect width="18" height="18" x="3" y="4" rx="2" />
                        <path d="M3 10h18" />
                      </svg>
                      {shortDate(post.data.date)}
                    </div>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="w-4 h-4 text-muted-foreground group-hover:text-neon transition-colors"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

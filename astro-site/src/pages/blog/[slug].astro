---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogStructuredData from "@/components/BlogStructuredData.astro";

// Port of app/blog/[slug]/page.tsx — getStaticPaths over the blog collection.
export const getStaticPaths = (async () => {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

// getRelatedPosts(slug, category, 2): same category, newest first, minus self.
const relatedPosts = (await getCollection("blog"))
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2);

// `timeZone: "UTC"` pins the output to the frontmatter calendar date regardless
// of the build host timezone (matches the Next production output).
const longDate = new Date(post.data.date).toLocaleDateString("es-AR", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  keywords={post.data.keywords}
  canonical={`https://keisoftware.dev/blog/${post.id}`}
  ogType="article"
  ogTitle={`${post.data.title} | KEI Software`}
  ogDescription={post.data.excerpt}
  ogUrl={`https://keisoftware.dev/blog/${post.id}`}
  image={`/blog/${post.id}/opengraph-image.png`}
  ogImageAlt="Artículo del blog · KEI Software"
  twitterTitle={post.data.title}
  twitterDescription={post.data.excerpt}
  twitterImage={`/blog/${post.id}/opengraph-image.png`}
  twitterImageAlt="Artículo del blog · KEI Software"
  publishedTime={post.data.date}
  authors={[post.data.author.name]}
>
  <BlogStructuredData slot="head" mode="post" post={post} />
  <div class="min-h-screen bg-background">
    {/* Header */}
    <header class="border-b border-border/40">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-neon transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
          >
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Volver al blog
        </a>
      </div>
    </header>

    {/* Article */}
    <article class="py-12 sm:py-16 px-4 sm:px-6">
      <div class="max-w-4xl mx-auto">
        {/* Category badge */}
        <div class="flex items-center gap-2 mb-6">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4 text-neon"
          >
            <path
              d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"
            ></path>
            <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle>
          </svg>
          <span class="text-xs font-mono text-neon uppercase tracking-wider">
            {post.data.category}
          </span>
        </div>

        {/* Title */}
        <h1
          class="text-3xl sm:text-5xl lg:text-6xl font-black text-foreground leading-tight mb-6"
        >
          {post.data.title}
        </h1>

        {/* Meta info */}
        <div
          class="flex flex-wrap items-center gap-4 sm:gap-6 pb-8 mb-8 border-b border-border/40"
        >
          <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <path d="M8 2v4"></path>
              <path d="M16 2v4"></path>
              <rect width="18" height="18" x="3" y="4" rx="2"></rect>
              <path d="M3 10h18"></path>
            </svg>
            {longDate}
          </div>
          <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {post.data.readTime}
          </div>
          <div class="text-sm text-muted-foreground">
            Por{" "}
            <span class="text-foreground font-medium">
              {post.data.author.name}
            </span>
          </div>
        </div>

        {/* Excerpt */}
        <p
          class="text-lg sm:text-xl text-muted-foreground leading-relaxed mb-12 pb-8 border-b border-border/40"
        >
          {post.data.excerpt}
        </p>

        {/* Content */}
        <div class="prose prose-invert max-w-none">
          <div class="blog-content">
            <Content />
          </div>
        </div>

        {/* CTA */}
        <div class="mt-16 p-8 border border-neon/20 bg-neon/5 rounded-sm">
          <h3 class="text-xl font-bold text-foreground mb-3">
            ¿Listo para llevar tu proyecto al siguiente nivel?
          </h3>
          <p class="text-muted-foreground mb-6">
            Conversemos sobre cómo podemos ayudarte a implementar estas
            soluciones en tu negocio.
          </p>
          <a
            href="/#contacto"
            class="inline-flex items-center gap-2 px-6 py-3 bg-neon text-background font-bold text-sm tracking-wide hover:bg-neon-bright transition-all rounded-sm"
          >
            Agendar consulta gratuita →
          </a>
        </div>
      </div>
    </article>

    {/* Related posts */}
    {
      relatedPosts.length > 0 && (
        <section class="py-12 sm:py-16 px-4 sm:px-6 border-t border-border/40 bg-surface/20">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-sm font-mono tracking-wider text-muted-foreground uppercase mb-8">
              Artículos relacionados
            </h2>
            <div class="grid sm:grid-cols-2 gap-6">
              {relatedPosts.map((relatedPost) => (
                <a
                  href={`/blog/${relatedPost.id}`}
                  class="group block p-6 border border-border/60 rounded-sm hover:border-neon/40 hover:bg-surface/50 transition-all"
                >
                  <span class="text-xs font-mono text-neon uppercase tracking-wider">
                    {relatedPost.data.category}
                  </span>
                  <h3 class="text-lg font-bold text-foreground mt-3 mb-2 group-hover:text-neon transition-colors">
                    {relatedPost.data.title}
                  </h3>
                  <p class="text-sm text-muted-foreground line-clamp-2">
                    {relatedPost.data.excerpt}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

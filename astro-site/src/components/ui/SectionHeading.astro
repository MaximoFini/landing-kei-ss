---
// Port of components/ui/section-heading.tsx.
//
// Framer → CSS reveal: the wrapper's
//   initial={{ opacity: 0, y: 20 }} / animate {opacity:1,y:0} / transition={{ duration: 0.5 }}
// becomes `.reveal` with --reveal-y:20px, --reveal-dur:.5s (default ease-out).
//
// The <DiaTextReveal> diagonal gradient sweep on the title + subtitle is
// restored as a pure-CSS component (DiaTextReveal.astro) — matches the original
// BRAND_COLORS and REVEAL_DURATION (1.3s).
import DiaTextReveal from "@/components/ui/DiaTextReveal.astro";

const BRAND_COLORS = ["#0b1a42", "#1a4fc0", "#3f7dff", "#bcdcff"];
const REVEAL_DURATION = 1.3;

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  description?: string;
  align?: "center" | "left";
  class?: string;
  subtitleClass?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  description,
  align = "center",
  class: className = "",
  subtitleClass = "mt-2",
} = Astro.props;

const centered = align === "center";
---

<div
  class:list={[
    "reveal mb-12 sm:mb-16",
    centered ? "text-center" : "text-left",
    className,
  ]}
  style="--reveal-y:20px; --reveal-dur:.5s"
>
  {
    eyebrow && (
      <span class="mb-4 block font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.3em] text-[#3f7dff]">
        {eyebrow}
      </span>
    )
  }

  <h2
    class="font-google-sans text-4xl font-[450] tracking-normal text-foreground sm:text-5xl lg:text-6xl"
  >
    <DiaTextReveal
      text={title}
      colors={BRAND_COLORS}
      duration={REVEAL_DURATION}
    />
  </h2>

  {
    subtitle && (
      <DiaTextReveal
        text={subtitle}
        colors={BRAND_COLORS}
        duration={REVEAL_DURATION}
        class:list={[
          "block font-google-sans text-sm font-[450] tracking-normal sm:text-base",
          subtitleClass,
        ]}
      />
    )
  }

  {
    description && (
      <p
        class:list={[
          "mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base",
          centered ? "mx-auto max-w-xl" : "max-w-xl",
        ]}
      >
        {description}
      </p>
    )
  }
</div>

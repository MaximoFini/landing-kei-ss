  <div class="star-field__layer star-field__layer--b"></div>
  <div class="star-field__layer star-field__layer--c"></div>
  <div class="star-field__layer star-field__layer--d"></div>
  <div class="star-field__layer star-field__layer--e"></div>
</div>

---
// Port of components/process.tsx.
//
// Framer → CSS reveal:
//   StepCard <m.div>:
//     initial={{ opacity: 0, y: 28 }} / animate {opacity:1,y:0}
//     transition={{ duration: 0.55, delay: index * 0.12, ease: [0.22, 1, 0.36, 1] }}
//     useInView(ref, { once: true, margin: "-80px" })
//     whileHover={{ y: -4 }}
//   → outer `.reveal` wrapper with
//     --reveal-y:28px; --reveal-dur:.55s; --reveal-ease:cubic-bezier(.22,1,.36,1);
//     --reveal-delay: 0 / .12s / .24s / .36s
//     whileHover y:-4 → `hover:-translate-y-1` on the card (Tailwind -translate-y-1 = 4px)
//
//   CTA <m.div>:
//     initial={{ opacity: 0, y: 20 }} / transition={{ duration: 0.5, delay: 0.4 }}
//     useInView({ once:true, margin:"-60px" })
//   → `.reveal` with --reveal-y:20px; --reveal-dur:.5s; --reveal-delay:.4s
//
// DotGrid → static CSS dots (see DotGrid.astro). BorderBeam → CSS motion-path
// keyframe (see BorderBeam.astro). SectionHeading → SectionHeading.astro.
import SectionHeading from "@/components/ui/SectionHeading.astro";
import DotGrid from "@/components/ui/DotGrid.astro";
import BorderBeam from "@/components/ui/BorderBeam.astro";

const steps = [
  {
    num: "01",
    icon: "message",
    title: "Consulta gratuita",
    description:
      "Hablamos 30 minutos sin compromiso. Entendemos tu problema, tus objetivos y si podemos ayudarte.",
  },
  {
    num: "02",
    icon: "file",
    title: "Propuesta clara",
    description:
      "Recibís un documento detallado con alcance, cronograma, tecnologías y precio fijo. Sin sorpresas.",
  },
  {
    num: "03",
    icon: "code",
    title: "Desarrollo ágil",
    description:
      "Construimos en sprints cortos con demos semanales. Siempre sabés en qué estamos trabajando.",
  },
  {
    num: "04",
    icon: "rocket",
    title: "Entrega y soporte",
    description:
      "Lanzamos tu producto, te capacitamos y damos soporte técnico incluido durante el primer mes.",
  },
];

const revealEase = "cubic-bezier(0.22,1,0.36,1)";
---

<section
  id="proceso"
  class="relative overflow-hidden bg-[#fafbff] dark:bg-background px-4 pt-16 pb-12 sm:px-6 sm:pt-24 sm:pb-14 lg:pt-28 lg:pb-16"
>
  <DotGrid class="opacity-70" gap={38} baseColor="#dbe4f7" />

  <div class="relative z-10 mx-auto max-w-7xl">
    <SectionHeading
      eyebrow="Proceso"
      title="Cómo trabajamos"
      subtitle="De la idea al producto"
    />

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 xl:grid-cols-4">
      {
        steps.map((step, index) => (
          <div
            class="reveal"
            style={`--reveal-y:28px; --reveal-dur:.55s; --reveal-ease:${revealEase}; --reveal-delay:${(index * 0.12).toFixed(2)}s`}
          >
            <div class="group relative flex h-full flex-col gap-5 overflow-hidden rounded-2xl border border-border bg-card p-6 shadow-[0_2px_16px_-8px_rgba(10,14,26,0.08)] dark:shadow-[0_2px_16px_-8px_rgba(0,0,0,0.5)] transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:border-[#3f7dff]/35 hover:shadow-[0_24px_60px_-20px_rgba(63,125,255,0.35)]">
              <BorderBeam
                size={70}
                duration={7 + index}
                delay={index * 1.2}
                colorFrom="#bcdcff"
                colorTo="#3f7dff"
                borderWidth={1.5}
              />

              {/* Light wash from the top on hover */}
              <div
                class="pointer-events-none absolute inset-0 [clip-path:circle(0%_at_50%_0%)] transition-[clip-path] duration-700 ease-out group-hover:[clip-path:circle(150%_at_50%_0%)]"
                style="background:linear-gradient(to bottom, rgba(63,125,255,0.22) 0%, rgba(63,125,255,0.08) 60%, transparent 100%)"
              />

              <div class="relative z-10 flex items-center justify-between">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-[#3f7dff]/20 bg-[#3f7dff]/10 transition-all duration-300 group-hover:border-[#3f7dff]/40 group-hover:bg-[#3f7dff]/15 group-hover:shadow-[0_0_20px_rgba(63,125,255,0.35)]">
                  {step.icon === "message" && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-[#3f7dff]"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  )}
                  {step.icon === "file" && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-[#3f7dff]"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/></svg>
                  )}
                  {step.icon === "code" && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-[#3f7dff]"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                  )}
                  {step.icon === "rocket" && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-[#3f7dff]"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
                  )}
                </div>
                <span class="font-google-sans text-3xl font-[450] text-foreground/[0.08] transition-colors duration-300 group-hover:text-[#3f7dff]/25">
                  {step.num}
                </span>
              </div>

              <div class="relative z-10 flex-1">
                <h3 class="mb-2 font-google-sans text-lg font-[450] text-foreground">
                  {step.title}
                </h3>
                <p class="text-sm leading-relaxed text-muted-foreground">
                  {step.description}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div
      class="reveal mt-8 sm:mt-10 flex justify-center"
      style="--reveal-y:20px; --reveal-dur:.5s; --reveal-delay:.4s"
    >
      <a
        href="#contacto"
        class="group inline-flex items-center justify-center gap-2 rounded-full bg-[#3f7dff] px-7 py-3.5 text-[15px] font-semibold text-white transition-all duration-200 hover:scale-[1.03] hover:bg-[#2f6bec] active:scale-95"
      >
        Empezá - Primer consulta gratis
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
